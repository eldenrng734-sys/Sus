APP_ENV=development

# ── PostgreSQL superuser (used by Docker Compose to init the database) ─────────
POSTGRES_USER=crm_owner
POSTGRES_PASSWORD=<change-me>
POSTGRES_DB=crm

# ── Application role (crm_app) — used by the FastAPI backend ──────────────────
DATABASE_URL=postgresql+psycopg://crm_app:<crm-app-password>@db:5432/crm

# ── Worker role (crm_worker) — used by the AI worker and dispatcher ────────────
WORKER_DATABASE_URL=postgresql+psycopg://crm_worker:<crm-worker-password>@db:5432/crm

# ── Migrator role (crm_migrator) — used by Alembic only ──────────────────────
MIGRATION_DATABASE_URL=postgresql+psycopg://crm_migrator:<crm-migrator-password>@db:5432/crm

# ── Backup role (crm_backup) — used by backup_job/backup.sh only ─────────────
BACKUP_DATABASE_URL=postgresql+psycopg://crm_backup:<crm-backup-password>@db:5432/crm

# ── Auth ───────────────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=<your-jwt-secret>

# ── LLM ───────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_REVIEW_CONFIDENCE_THRESHOLD=0.6

# ── Meta / WhatsApp ────────────────────────────────────────────────────────────
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=
WHATSAPP_VERIFY_TOKEN=
INTEGRATION_ENCRYPTION_KEY=

# dev/test only, replaced by the integrations API later
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_ACCESS_TOKEN=<whatsapp-access-token>

# ── Internal service auth ─────────────────────────────────────────────────────
# n8n → backend (verified by core/service_auth.py).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SERVICE_HMAC_SECRET=<service-hmac-secret>

# backend dispatcher → n8n (must differ from SERVICE_HMAC_SECRET).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
N8N_EVENT_SIGNING_SECRET=<n8n-event-signing-secret>

# ── n8n ────────────────────────────────────────────────────────────────────────
# n8n credential store. Never change after the first n8n start.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
N8N_ENCRYPTION_KEY=<n8n-encryption-key>

# n8n's own Postgres database (separate from the CRM database)
N8N_DB_USER=n8n
N8N_DB_PASSWORD=<n8n-db-password>
N8N_DB_NAME=n8n
