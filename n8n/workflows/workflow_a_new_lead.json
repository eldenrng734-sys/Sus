{
  "name": "Workflow A: New Lead Orchestration",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "lead-created",
        "responseMode": "onReceived",
        "options": {
          "rawBody": true
        }
      },
      "id": "1",
      "name": "Webhook lead.created",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [200, 300],
      "webhookId": "lead-created"
    },
    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\n\nconst item = $input.first();\nconst headers = item.json.headers || {};\nconst rawBody = item.json.rawBody || JSON.stringify(item.json.body || {});\n\nconst eventId = headers['x-event-id'];\nconst timestampStr = headers['x-timestamp'];\nconst signature = headers['x-signature'];\n\nif (!signature || !timestampStr || !eventId) {\n  throw new Error('Missing required webhook verification headers');\n}\n\nconst timestamp = parseInt(timestampStr, 10);\nconst now = Math.floor(Date.now() / 1000);\nif (Math.abs(now - timestamp) > 300) {\n  throw new Error('Timestamp skew exceeds 300 seconds');\n}\n\nconst secret = $env.N8N_EVENT_SIGNING_SECRET || '';\nconst canonical = timestampStr + '.' + rawBody;\nconst expectedSig = 'sha256=' + crypto.createHmac('sha256', secret).update(canonical, 'utf8').digest('hex');\n\nif (signature !== expectedSig) {\n  throw new Error('Invalid X-Signature');\n}\n\nconst parsed = typeof item.json.body === 'object' ? item.json.body : JSON.parse(rawBody);\n\nreturn [{\n  json: {\n    event_id: eventId,\n    event_type: parsed.event_type,\n    tenant_id: parsed.tenant_id,\n    lead_id: parsed.payload ? parsed.payload.lead_id : parsed.aggregate_id,\n    occurred_at: parsed.occurred_at\n  }\n}];"
      },
      "id": "2",
      "name": "Verify Dispatcher Signature",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [420, 300]
    },
    {
      "parameters": {
        "workflowId": "subworkflow_sign_and_call",
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
            "method": "GET",
            "path": "=/internal/v1/automation/leads/{{ $json.lead_id }}",
            "tenant_id": "={{ $json.tenant_id }}",
            "idempotency_key": "={{ $json.event_id }}-get-lead"
          }
        }
      },
      "id": "3",
      "name": "Fetch Lead Context",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1,
      "position": [640, 300]
    },
    {
      "parameters": {
        "workflowId": "subworkflow_sign_and_call",
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
            "method": "POST",
            "path": "=/internal/v1/automation/leads/{{ $('Verify Dispatcher Signature').item.json.lead_id }}/assess",
            "tenant_id": "={{ $('Verify Dispatcher Signature').item.json.tenant_id }}",
            "idempotency_key": "={{ $('Verify Dispatcher Signature').item.json.event_id }}-assess",
            "body": {}
          }
        }
      },
      "id": "4",
      "name": "Ensure Lead Assessed",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1,
      "position": [860, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $('Fetch Lead Context').item.json.data.assigned_user_id }}",
              "operation": "isNotEmpty"
            }
          ]
        }
      },
      "id": "5",
      "name": "Is Rep Assigned?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1080, 300]
    },
    {
      "parameters": {
        "workflowId": "subworkflow_sign_and_call",
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
            "method": "POST",
            "path": "/internal/v1/automation/notifications",
            "tenant_id": "={{ $('Verify Dispatcher Signature').item.json.tenant_id }}",
            "idempotency_key": "={{ $('Verify Dispatcher Signature').item.json.event_id }}",
            "body": {
              "user_id": "={{ $('Fetch Lead Context').item.json.data.assigned_user_id }}",
              "type": "new_lead",
              "title": "New Lead: {{ $('Fetch Lead Context').item.json.data.name }}",
              "body": "A new lead has been assigned to you.",
              "entity_type": "lead",
              "entity_id": "={{ $('Verify Dispatcher Signature').item.json.lead_id }}"
            }
          }
        }
      },
      "id": "6",
      "name": "Notify Assigned Rep",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1,
      "position": [1300, 200]
    }
  ],
  "connections": {
    "Webhook lead.created": {
      "main": [
        [
          {
            "node": "Verify Dispatcher Signature",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Verify Dispatcher Signature": {
      "main": [
        [
          {
            "node": "Fetch Lead Context",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Lead Context": {
      "main": [
        [
          {
            "node": "Ensure Lead Assessed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Ensure Lead Assessed": {
      "main": [
        [
          {
            "node": "Is Rep Assigned?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Is Rep Assigned?": {
      "main": [
        [
          {
            "node": "Notify Assigned Rep",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
